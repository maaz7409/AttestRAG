# ---------------------------------------------------------------------------
# Attest RAG configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# "openai" uses real OpenAI models. "fake" runs fully offline with
# deterministic local embeddings, an extractive answer generator and a
# heuristic judge (handy for demos, development and CI).
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

CHAT_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Infrastructure (docker-compose overrides the hosts automatically)
POSTGRES_USER=attestrag
POSTGRES_PASSWORD=attestrag
POSTGRES_DB=attestrag
DATABASE_URL=postgresql+asyncpg://attestrag:attestrag@localhost:5432/attestrag
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=attestrag_chunks

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Hybrid retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
FINAL_TOP_K=6
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0

# LLM-as-a-Judge guardrails
JUDGE_ENABLED=true
# "stream": stream tokens live, judge afterwards and retract if it fails.
# "strict": buffer the answer, judge it, and only then deliver it.
GUARDRAIL_MODE=stream
FAITHFULNESS_THRESHOLD=0.6
CONTEXT_RELEVANCE_THRESHOLD=0.4
TOXICITY_THRESHOLD=0.5

MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
